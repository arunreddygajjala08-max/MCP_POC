table Orders
	lineageTag: f7183d9e-9629-474a-a8e9-5ccb26d989cd

	measure 'Returned Order Count' =
			CALCULATE(
			    DISTINCTCOUNT(Returns[Order ID]),
			    Returns[Returned] = "Yes",
			    KEEPFILTERS(TREATAS(VALUES(Orders[Order ID]), Returns[Order ID]))
			)
		formatString: 0
		lineageTag: 7585e140-3f92-428b-8718-2abab5b8529d

